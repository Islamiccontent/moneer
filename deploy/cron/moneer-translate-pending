# الكنس الدوري لترجمات المستندات غير المكتملة كل عشر دقائق؛ يُنسخ إلى /etc/cron.d/ بصلاحيات 644 بعد تعديل المستخدم والمسار، ومجلد السجل /var/log/moneer يجب أن يوجد ويملكه مستخدم الخدمة.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
*/10 * * * * moneer cd /home/moneer-testing-env && .venv/bin/python manage.py translate_pending >> /var/log/moneer/translate_pending.log 2>&1
