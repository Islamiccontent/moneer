# انسخ هذا الملف إلى .env واملأ القيم؛ قيمة واحدة في كل سطر وبلا تعليق في نهاية السطر.

# توليد المفتاح: .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# أصول CSRF الموثوقة بالمخطط ومفصولة بفواصل (مثل https://moneer.example.com)؛ تُترك فارغة محلياً
CSRF_TRUSTED_ORIGINS=

# PostgreSQL 17
DB_NAME=moneer_db
DB_USER=moneer_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# مصدر قائمة اللغات للأمر import_languages
ICADB_LANGUAGES_URL=https://icadb.com/api/languages/list/

# طبقة BERT الاختيارية في classify: BERT_LAYER=1 يفعّلها وBERT_DIR مسار حزمة النموذج (خارج المستودع)
BERT_LAYER=
BERT_DIR=
# HADITH_MATCH=1 يفعّل مطابقة فهرس الحديث (يحمّل classify/data/hadith.json بكامله)
HADITH_MATCH=

# المراجع اللغوي بعد BERT (Gemini يقترح والفهرس يجيز)؛ المفتاح يُوضع في .env.local خارج git
GEMINI_API_KEY=
LLM_REVIEW=0
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
LLM_HEADINGS=1
GEMINI_RPM=10

# مجلد ملفات استيراد ترجمات القرآن (QuranKB*.xlsx وquran_<iso>.xlsx)؛ نسبي إلى جذر المشروع أو مطلق
QURAN_KB_DIR=imports/quran-kb

# نموذج Gemini لترجمة النصوص (بالمفتاح GEMINI_API_KEY أعلاه)
TRANSLATE_MODEL=gemini-3.8-flash
# القاعدة المركزية لأمثلة الترجمة
CENTRAL_DB_URL=https://icadb.com
# OpenAI لاستخراج ترجمة الآيات من الترجمة المعتمدة
OPENAI_API_KEY=
QURAN_EXTRACT_MODEL=gpt-5-nano

# backend المهام الخلفية: الافتراضي فوري للتطوير، وفي الإنتاج django_tasks_db.DatabaseBackend مع db_worker
TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend

# تطبيق export: مفتاح ترخيص Spire.Doc لتوليد DOCX/PDF (اختياري؛ بدونه تحذير التقييم في الملف)
SPIRE_DOC_KEY=

# تطبيق audit: تدقيق الترجمة فورياً بقواعد محلية ثم Gemini (بالمفتاح GEMINI_API_KEY أعلاه)
AUDIT_MODEL=gemini-3.8-flash
# مستوى التفكير high/low؛ فارغ = لا يُرسل thinkingConfig
AUDIT_THINKING_LEVEL=high
AUDIT_TEMPERATURE=0.2
AUDIT_USE_SCHEMA=0
# عدد الجمل في طلب Gemini الواحد، ومحاولات المجموعة قبل أن تُعدّ فاشلة
AUDIT_GROUP_SIZE=20
AUDIT_MAX_ATTEMPTS=3
AUDIT_HTTP_TIMEOUT=60
AUDIT_HTTP_RETRIES=3
# حدود مؤشر الطول الشاذ نسبةً إلى وسيط الملف
AUDIT_LEN_SHORT_RATIO=0.40
AUDIT_LEN_LONG_RATIO=3.0
